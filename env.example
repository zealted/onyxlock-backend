# ── Flutterwave ───────────────────────────────────────────────────────────────
# Get these from https://dashboard.flutterwave.com/dashboard/settings/apis
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# Set this to any random secret string — paste the same value in Flutterwave webhook settings
FLW_WEBHOOK_HASH=make_up_any_random_string_here_e.g._onyxlock2024secret

# ── Your Website ──────────────────────────────────────────────────────────────
WEBSITE_URL=https://yourdomain.com

# ── Email (for sending license keys) ─────────────────────────────────────────
# Gmail: enable 2FA → myaccount.google.com/apppasswords → create App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
